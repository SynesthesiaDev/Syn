func MayBeNull -> Int? {
    let random = Random.Int(1, 5);
    return random == 5 ? null : random; 
}

func CallsNullable() -> {   
    let thing = MayBeNull() ?? 5;
    WriteLine("very complciated way to get the number anyway.. its ${thing}")
}

func Fill() -> String {
    var greeting string? = null;
    greeting ??= "hello";
    greeting ??= "ignored";
    return greeting ?? "fallback";
}

struct, class, record, record struct, interface, abstract class, abstract record, abstract.. struct?


//-----------------------------------------------------

func GetUserAge(name: String) -> !Int? {
    let user = FindUser(name)?          // ? propagates the error if there is error
    
    if (user.IsDeleted) {
        return null
    }
    
    return user.Age
}

func Main() -> {
    // propagate, default on error/null
    let age = GetUserAge("alice") ?? 0
    WriteLine("age: ${age}")

    // handle inline
    let age2 = GetUserAge("bob") catch { err =>
        Log("error: ${err}")
        -1
    }

    // panic if anything goes wrong
    let age3 = GetUserAge("dave")!!
}

func Unique() -> {
    let list = list(1, 2, 3, 6, 6, 9);
    let newList = mutableList();
    
    for(item in list) {
        if(newList.Contains(item)) continue;
        newList.Add(item);
    }
    
    while (condition) {
        if (something) break;
        DoWork();
    }
    
    do {
        DoWork();
    } while (condition);
    
    
}